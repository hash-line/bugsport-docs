---
import { render, type CollectionEntry } from 'astro:content';
import { DocsShell } from '@/components/DocsShell';
import { OpenAPIPage } from '@/components/OpenAPIPage';
import { openapi } from '@/lib/openapi';
import BaseLayout from '@/components/BaseLayout.astro';
import { source } from '@/lib/source';
import type { TOCItemType } from 'fumadocs-core/toc';
import { CodeBlockTab, CodeBlockTabs, CodeBlockTabsList, CodeBlockTabsTrigger } from '@/components/CodeTabs';
import defaultMdxComponents from 'fumadocs-ui/mdx';
import { createElement } from 'react';

interface Props {
  page: CollectionEntry<'docs'>;
}

export async function getStaticPaths() {
  return source.getPages()
    .filter((page) => page.slugs.length > 0)
    .map((page) => ({
      params: { slug: page.slugs.join('/') },
      props: { page: page.data._raw },
    }));
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
const openapiProps = page.data._openapi === undefined
  ? undefined
  : await openapi.preloadOpenAPIPage({ data: page.data } as never);
const toc: TOCItemType[] = headings.map((heading) => ({
  depth: heading.depth,
  title: heading.text,
  url: `#${heading.slug}`,
}));
const components = {
  ...defaultMdxComponents,
  CodeBlockTabs,
  CodeBlockTabsList,
  CodeBlockTabsTrigger,
  CodeBlockTab,
  ...(openapiProps === undefined
    ? {}
    : {
        OpenAPIPage: (props: Parameters<typeof OpenAPIPage>[0]) => createElement(OpenAPIPage, { ...props, ...openapiProps }),
      }),
};
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <DocsShell
    tree={source.getPageTree()}
    title={page.data.title}
    description={page.data.description}
    status={page.data.status}
    pathname={Astro.url.pathname}
    params={Astro.params}
    page={{ toc, full: page.data.full }}
    client:load
  >
    <Content components={components} />
  </DocsShell>
</BaseLayout>
