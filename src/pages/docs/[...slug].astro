---
import { render, type CollectionEntry } from 'astro:content';
import { DocsShell } from '@/components/DocsShell';
import { OpenAPIPage } from '@/components/OpenAPIPage';
import { openapi } from '@/lib/openapi';
import BaseLayout from '@/components/BaseLayout.astro';
import { source } from '@/lib/source';
import { markdownUrlForPage } from '@/lib/markdown';
import type { TOCItemType } from 'fumadocs-core/toc';
import defaultMdxComponents from 'fumadocs-ui/mdx';
import { createElement } from 'react';

interface Props {
  page: CollectionEntry<'docs'>;
  markdownUrl: string;
}

export async function getStaticPaths() {
  return source.getPages().map((page) => ({
    params: { slug: page.slugs.length > 0 ? page.slugs.join('/') : undefined },
    props: { page: page.data._raw, markdownUrl: markdownUrlForPage(page) },
  }));
}

const { page, markdownUrl } = Astro.props;
const { Content, headings } = await render(page);
const openapiProps = page.data._openapi === undefined
  ? undefined
  : await openapi.preloadOpenAPIPage({ data: page.data } as never);
const toc: TOCItemType[] = headings.map((heading) => ({
  depth: heading.depth,
  title: heading.text,
  url: `#${heading.slug}`,
}));
const components = openapiProps === undefined
  ? defaultMdxComponents
  : {
      ...defaultMdxComponents,
      OpenAPIPage: (props: Parameters<typeof OpenAPIPage>[0]) => createElement(OpenAPIPage, { ...props, ...openapiProps }),
    };
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <DocsShell
    tree={source.getPageTree()}
    pathname={Astro.url.pathname}
    params={Astro.params}
    page={{ toc }}
    markdownUrl={markdownUrl}
    client:load
  >
    <h1 class="text-3xl font-semibold">{page.data.title}</h1>
    {page.data.description && <p class="mb-8 text-lg text-fd-muted-foreground">{page.data.description}</p>}
    <div class="prose flex-1">
      <Content components={components} />
    </div>
  </DocsShell>
</BaseLayout>
