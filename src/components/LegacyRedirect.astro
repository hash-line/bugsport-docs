---
interface Props {
  target: string;
}

const { target } = Astro.props;
const canonical = new URL(target, Astro.site).href;
const replacementScript = `location.replace(${JSON.stringify(target)});`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>Page moved | BugsPort Docs</title>
  </head>
  <body>
    <main>
      <h1>Page moved</h1>
      <p>This documentation page has moved.</p>
      <p><a href={target}>Continue to the replacement page</a></p>
    </main>
    <script is:inline set:html={replacementScript}></script>
  </body>
</html>
